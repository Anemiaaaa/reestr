# Образец локальной конфигурации. Скопировать в .env и подставить значения.
# Сам .env под .gitignore и в репозиторий не попадает.

# Адрес, на котором слушает сервис. Только петля: в реестре лежат аудиты
# заказчиков с оборотами и сметами, наружу их отдавать нельзя.
REESTR_ADDR=127.0.0.1:8080

# База. Порт 5433, потому что 5432 на машине занят службой Postgres.
DATABASE_URL=postgres://reestr:reestr@127.0.0.1:5433/reestr?sslmode=disable

# Входящий вебхук Bitrix24 целиком, вместе с кодом и слешем на конце.
# Нужные права: im, user. Взять в Битриксе: Приложения → Разработчикам →
# Другое → Входящий вебхук.
BITRIX_WEBHOOK=https://ваш-портал.bitrix24.ru/rest/1/КОД/

# Модель, которая строит срез. BASE_URL вынесен в настройку намеренно:
# так переход с шлюза на прямой Anthropic — правка одной строки, а не кода.
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_MODEL=claude-opus-4-8

# Часовой пояс ночной пересборки. Совпадает с поясом портала Bitrix.
REESTR_TZ=Europe/Moscow

# Время ежедневной пересборки срезов, ЧЧ:ММ в поясе выше.
REESTR_REBUILD_AT=20:00
