# Образец локальной конфигурации. Скопировать в .env и подставить значения.
# Сам .env под .gitignore и в репозиторий не попадает.

# Адрес, на котором слушает сервис. Только петля: в реестре лежат аудиты
# заказчиков с оборотами и сметами, наружу их отдавать нельзя.
REESTR_ADDR=127.0.0.1:8080

# База. Порт 5433, потому что 5432 на машине занят службой Postgres.
DATABASE_URL=postgres://reestr:reestr@127.0.0.1:5433/reestr?sslmode=disable

# Входящий вебхук Bitrix24 целиком, вместе с кодом и слешем на конце.
# Нужные права: im, user. Взять в Битриксе: Приложения → Разработчикам →
# Другое → Входящий вебхук.
BITRIX_WEBHOOK=https://ваш-портал.bitrix24.ru/rest/1/КОД/

# Модель, которая строит срез. Без ключа или без модели реестр работает
# целиком, показывая разбор, собранный руками.
#
# Разговор идёт в формате OpenAI (/chat/completions) — на нём говорят все
# доступные из России шлюзы.
#
# Имена свои, с приставкой REESTR_, и это не косметика. Раньше здесь стояли
# ANTHROPIC_BASE_URL и ANTHROPIC_API_KEY, и на машине, где установлен любой
# инструмент Anthropic, ANTHROPIC_BASE_URL задан в окружении и указывает на
# api.anthropic.com. Окружение старше этого файла — правило верное, — и реестр
# молча ходил в чужой адрес вместо шлюза. Ошибки при запуске не было никакой:
# разбор падал на первом вызове с пустым 404, который отдаёт чужой Cloudflare
# на несуществующий у него путь. Полдня разбирательства.
#
# Старые имена ещё читаются, но только если новых нет.
#
# Проверено на HydraAI. gpt-5-mini — около 0,5 ₽ за разбор, разбирает
# заметно беднее, но работает. claude-sonnet-4.6 — около 4,5 ₽ и подробнее
# всех. claude-sonnet-5 через этот шлюз не годится: тратит весь потолок
# токенов на рассуждения и до вызова инструмента не доходит.
REESTR_MODEL_URL=https://apihydraai.ru/v1
REESTR_MODEL_KEY=sk-...
REESTR_MODEL=gpt-5-mini

# Узел шлюза сервер пишет в лог при каждом запуске: подмена адреса ничем, кроме
# отказа разбора, не проявляется, и увидеть её можно только там.

# Кто может войти: «логин:пароль» через запятую.
#
# Пустое значение выключает вход, и это законно только на петле (127.0.0.1).
# На любом другом адресе сервер откажется стартовать без этой настройки: в
# реестре лежат аудиты заказчиков и журнал инцидентов по сотрудникам.
#
# ВНИМАНИЕ: пароль, совпадающий с логином, подбирается первой же попыткой.
# Смените до публикации в сеть — сервер напоминает об этом при каждом запуске.
REESTR_USERS=kurban:kurban,amirullah:amirullah

# Кто видит журнал инцидентов, через запятую. Логины — из REESTR_USERS.
#
# В журнале записи о работе конкретных людей, и читать их должен тот, кто
# оценивает, а не тот, кого оценивают. Пусто означает «видят все, кто вошёл» —
# сервер напоминает об этом при запуске. Всё остальное в реестре общее: задачи,
# срезы и источники делить незачем.
REESTR_MANAGERS=

# Ключ подписи пропусков. Пустой — не беда: сервер заведёт ключ сам и положит
# его в data/session.key, так что вход переживёт перезапуск. Задавать эту
# настройку стоит там, где рабочий каталог не постоянный, — в контейнере без
# тома файл пропадёт вместе с ним.
#
# Смена ключа — это выход со всех устройств разом. Другого способа отозвать
# выданные пропуска нет: они самодостаточны и на сервере не хранятся.
REESTR_SECRET=

# Часовой пояс ночной пересборки. Совпадает с поясом портала Bitrix.
REESTR_TZ=Europe/Moscow

# Время ежедневной пересборки срезов, ЧЧ:ММ в поясе выше.
#
# Ночь идёт в два шага: сначала подтягивается переписка из портала (бесплатно),
# потом пересобираются срезы задач, у которых появился материал (платно).
REESTR_REBUILD_AT=20:00

# Сколько задач за ночь разрешено отдать модели. Пусто — десять.
#
# Предел стоит ради счёта, а не ради скорости: ночь, когда материал появился
# разом у всех задач, без предела списала бы весь остаток, и узнали бы об этом
# утром. Что не успели — разберётся следующей ночью или по кнопке.
# Ноль означает «без предела».
REESTR_NIGHTLY_LIMIT=10
